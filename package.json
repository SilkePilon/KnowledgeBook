{
  "name": "knowledgebook",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "frontend": "pnpm --filter frontend dev",
    "backend": "pnpm --filter backend dev",
    "dev": "concurrently \"pnpm run frontend\" \"pnpm run backend\"",
    "install:all": "pnpm install --ignore-scripts && node scripts/build-pathfinder.mjs",
    "build:pathfinder": "node scripts/build-pathfinder.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "knip": "^5.30.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "sharp",
      "unrs-resolver"
    ]
  }
}
